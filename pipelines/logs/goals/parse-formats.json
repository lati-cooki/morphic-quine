      "expected": {
        "level": "DEBUG",
        "service": "db",
        "message": "job 8812 retried",
        "ts": "2026-09-23T14:03:11Z"
      }
    },
    {
      "input": {
        "id": "j4",
        "line": "{\"ts\": \"2026-09-23T14:04:11Z\", \"level\": \"warn\", \"service\": \"auth\", \"msg\": \"index rebuild took 14s\"}"
