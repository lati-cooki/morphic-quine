# Patch provider. First available wins unless MUTATOR_PROVIDER forces one: anthropic | gemini | reference
# With no key set, the built-in reference repair closes the loop for the shipped JIT_Cache defect only.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# MUTATOR_PROVIDER=anthropic
# ENGINE_PORT=3001
# ATTACKER=fuzz            # force the structural fuzzer even when an LLM provider is configured
# PROVIDER_TIMEOUT_MS=120000  # per model call; gemini-2.5-pro on large prompts can need 180000
# DAILY_BUDGET_USD=2        # estimated model spend per local day before the sentinel stops synthesizing
